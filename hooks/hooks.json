{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__((place|replace)_(stock|equity|options?|futures|crypto|event|algo)(_.*)?|create_community_(post|comment))",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/order_gate.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/protect_files.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__place_stock_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/order_gate.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
